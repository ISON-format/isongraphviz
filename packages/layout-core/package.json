  "dependencies": { "isongraph-visualize-scene-core": "file:../scene-core", "ison-graph-ts": "1.4.1" },
  "devDependencies": { "@types/node": "22.20.5", "esbuild": "0.28.2", "playwright-core": "1.65.1", "typescript": "5.9.3", "vitest": "4.1.12" }
}
