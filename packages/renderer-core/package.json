{
  "name": "isongraph-visualize-renderer-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGR/1 renderer contract and conformance kit",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./headless": {
      "types": "./dist/headless/index.d.ts",
      "import": "./dist/headless/index.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./conformance/node": {
      "types": "./dist/conformance/node.d.ts",
      "import": "./dist/conformance/node.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/vitest.mjs run",
    "check": "npm run typecheck && npm test && npm run test:slow && npm run build",
    "smoke": "node scripts/smoke.mjs",
    "test:slow": "node scripts/vitest.mjs run --config vitest.slow.config.ts"
  },
  "dependencies": {
    "isongraph-visualize-scene-core": "file:../scene-core",
    "isongraph-visualize-layout-core": "file:../layout-core"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "playwright-core": "1.65.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
