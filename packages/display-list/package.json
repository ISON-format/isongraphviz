{
  "name": "isongraph-visualize-display-list",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "IGR-DL/1 display list, igr-pick/1 pick buffer, igr-cv/1 Canvas replay and igr-xr/1 readouts",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./canvas2d": {
      "types": "./dist/canvas2d/index.d.ts",
      "import": "./dist/canvas2d/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.core.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/vitest.mjs run",
    "test:slow": "node scripts/vitest.mjs run --config vitest.slow.config.ts",
    "check": "npm run typecheck && npm test && npm run test:slow && npm run build && npm run smoke",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "isongraph-visualize-renderer-core": "file:../renderer-core"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "isongraph-visualize-layout-core": "file:../layout-core",
    "isongraph-visualize-scene-core": "file:../scene-core",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
