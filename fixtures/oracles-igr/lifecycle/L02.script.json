{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "hitTest",
   "arg": {
    "x": 1,
    "y": 1
   },
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "probe",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "render",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "export",
   "arg": "scene",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_INITIALIZED"
  }
 ],
 "expect_recorded_events": "events/L02.recorded.events.json"
}