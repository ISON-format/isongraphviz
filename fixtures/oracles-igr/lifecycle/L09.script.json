{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "arg": {
    "plain_object_model": true
   },
   "await": true,
   "expect": "INVALID_INPUT/NOT_A_RENDER_MODEL"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_LOADED"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L09.c4.state.json"
  },
  {
   "op": "loadScene",
   "arg": {
    "plain_object_model": true
   },
   "await": true,
   "expect": "INVALID_INPUT/NOT_A_RENDER_MODEL"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L09.c6.state.json"
  }
 ],
 "expect_recorded_events": "events/L09.recorded.events.json"
}