{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "setReducedMotion",
   "arg": true,
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "probe",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L23.c3.state.json",
   "expect_motion": "none"
  },
  {
   "op": "setReducedMotion",
   "arg": false,
   "await": true,
   "expect": "ok"
  },
  {
   "op": "setReducedMotion",
   "arg": true,
   "await": true,
   "expect": "ok"
  },
  {
   "op": "probe",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L23.c6.state.json",
   "expect_motion": "none"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "pan",
    "dx": 3,
    "dy": 3
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L23.c7.events.json",
   "expect_state": "states/L23.c7.state.json"
  },
  {
   "op": "probe",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L23.c8.state.json",
   "expect_motion": "none"
  },
  {
   "op": "dispose",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "setReducedMotion",
   "arg": true,
   "await": true,
   "expect": "INVALID_LIFECYCLE/DISPOSED"
  }
 ],
 "expect_recorded_events": "events/L23.recorded.events.json"
}