{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "arg": {
    "initial": "states/S11.state.json"
   },
   "await": true,
   "expect": "INVALID_STATE/SCENE_MISMATCH"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "INVALID_LIFECYCLE/NOT_LOADED"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L08.c4.events.json",
   "expect_state": "states/L08.c4.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L08.c5.state.json"
  },
  {
   "op": "loadScene",
   "arg": {
    "initial": "states/S11.state.json"
   },
   "await": true,
   "expect": "INVALID_STATE/SCENE_MISMATCH"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L08.c7.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "focus-step",
    "delta": 1
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L08.c8.events.json",
   "expect_state": "states/L08.c8.state.json"
  },
  {
   "op": "loadScene",
   "arg": {
    "plain_object_model": true
   },
   "await": true,
   "expect": "INVALID_INPUT/NOT_A_RENDER_MODEL"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L08.c10.state.json"
  }
 ],
 "expect_recorded_events": "events/L08.recorded.events.json"
}