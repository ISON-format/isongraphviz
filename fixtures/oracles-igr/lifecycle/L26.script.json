{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "arg": {
    "at_capacity": "nodes"
   },
   "await": true,
   "expect": "ok",
   "applies_if": "capacity-at-most-1000000"
  },
  {
   "op": "loadScene",
   "arg": {
    "at_capacity": "edges"
   },
   "await": true,
   "expect": "ok",
   "applies_if": "capacity-at-most-1000000"
  }
 ],
 "expect_recorded_events": "events/L26.recorded.events.json"
}