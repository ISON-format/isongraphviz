{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     },
     {
      "edge": {
       "ord": "0",
       "rel": "KNOWS",
       "src": {
        "id": "i:1",
        "type": "person"
       },
       "tgt": {
        "id": "s:ann",
        "type": "person"
       }
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L16.c2.events.json",
   "expect_state": "states/L16.c2.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L16.c3.state.json"
  },
  {
   "op": "export",
   "arg": "scene",
   "await": true,
   "expect": "ok",
   "expect_bytes": "../oracles/o1-basic.scene.json",
   "expect_media_type": "application/octet-stream"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L16.c5.state.json"
  }
 ],
 "expect_recorded_events": "events/L16.recorded.events.json"
}