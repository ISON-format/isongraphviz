{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "applySceneDelta",
   "arg": {},
   "await": true,
   "expect": "UNSUPPORTED_CAPABILITY/RESERVED"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "applySceneDelta",
   "arg": {},
   "await": true,
   "expect": "UNSUPPORTED_CAPABILITY/RESERVED"
  },
  {
   "op": "applySceneDelta",
   "arg": {
    "type": "anything",
    "x": [
     1,
     2
    ]
   },
   "await": true,
   "expect": "UNSUPPORTED_CAPABILITY/RESERVED"
  },
  {
   "op": "applySceneDelta",
   "await": true,
   "expect": "UNSUPPORTED_CAPABILITY/RESERVED"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L11.c6.state.json"
  }
 ],
 "expect_recorded_events": "events/L11.recorded.events.json"
}