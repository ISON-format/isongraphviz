{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L15.c2.state.json"
  },
  {
   "op": "export",
   "arg": "gif",
   "await": true,
   "expect": "INVALID_INPUT/UNKNOWN_FORMAT"
  },
  {
   "op": "export",
   "arg": "SCENE",
   "await": true,
   "expect": "INVALID_INPUT/UNKNOWN_FORMAT"
  },
  {
   "op": "export",
   "arg": "",
   "await": true,
   "expect": "INVALID_INPUT/UNKNOWN_FORMAT"
  },
  {
   "op": "export",
   "arg": 5,
   "await": true,
   "expect": "INVALID_INPUT/SCHEMA"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L15.c7.state.json"
  }
 ],
 "expect_recorded_events": "events/L15.recorded.events.json"
}