{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "render",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L01.c3.events.json",
   "expect_state": "states/L01.c3.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L01.c4.state.json"
  },
  {
   "op": "hitTest",
   "arg": {
    "x": 32.0,
    "y": 193.5
   },
   "await": true,
   "expect": "ok",
   "expect_hit": {
    "node": {
     "id": "i:1",
     "type": "person"
    }
   }
  },
  {
   "op": "probe",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L01.c6.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "resize",
    "width": 640,
    "height": 480
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L01.c7.events.json",
   "expect_state": "states/L01.c7.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L01.c8.state.json"
  },
  {
   "op": "export",
   "arg": "scene",
   "await": true,
   "expect": "ok",
   "expect_bytes": "../oracles/o1-basic.scene.json",
   "expect_media_type": "application/octet-stream"
  },
  {
   "op": "setReducedMotion",
   "arg": true,
   "await": true,
   "expect": "ok"
  },
  {
   "op": "probe",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L01.c11.state.json",
   "expect_motion": "none"
  },
  {
   "op": "dispose",
   "await": true,
   "expect": "ok"
  }
 ],
 "expect_recorded_events": "events/L01.recorded.events.json"
}