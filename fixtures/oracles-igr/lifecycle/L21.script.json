{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "throw",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     },
     {
      "node": {
       "id": "s:ann",
       "type": "person"
      }
     },
     {
      "edge": {
       "ord": "0",
       "rel": "KNOWS",
       "src": {
        "id": "i:1",
        "type": "person"
       },
       "tgt": {
        "id": "s:ann",
        "type": "person"
       }
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L21.c2.events.json",
   "expect_state": "states/L21.c2.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L21.c3.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "focus",
    "target": {
     "edge": {
      "ord": "0",
      "rel": "KNOWS",
      "src": {
       "id": "i:1",
       "type": "person"
      },
      "tgt": {
       "id": "s:ann",
       "type": "person"
      }
     }
    }
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L21.c4.events.json",
   "expect_state": "states/L21.c4.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "set-hidden",
    "hidden": true,
    "targets": [
     {
      "node": {
       "id": "s:ann",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L21.c5.events.json",
   "expect_state": "states/L21.c5.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L21.c6.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "focus-step",
    "delta": 1
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L21.c7.events.json",
   "expect_state": "states/L21.c7.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L21.c8.state.json"
  }
 ],
 "expect_on_error_count": 6
}