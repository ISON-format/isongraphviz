{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "arg": {
    "size": {
     "width": 0,
     "height": 600
    }
   },
   "await": true,
   "expect": "INVALID_INPUT/OUT_OF_RANGE"
  },
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L24d.c3.state.json"
  }
 ],
 "expect_recorded_events": "events/L24d.recorded.events.json"
}