{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "record",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L07.c2.events.json",
   "expect_state": "states/L07.c2.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L07.c3.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "resize",
    "width": 640,
    "height": 480
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L07.c4.events.json",
   "expect_state": "states/L07.c4.state.json"
  },
  {
   "op": "loadScene",
   "arg": {
    "model": {
     "scene": "../oracles/o4-undirected.scene.json",
     "layout": "../oracles-igl/layouts/F02.layout.json"
    }
   },
   "await": true,
   "expect": "ok"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L07.c6.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "focus-step",
    "delta": 1
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L07.c7.events.json",
   "expect_state": "states/L07.c7.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L07.c8.state.json"
  },
  {
   "op": "loadScene",
   "arg": {
    "model": {
     "scene": "../oracles/o1-basic.scene.json",
     "layout": "../oracles-igl/layouts/F01.layout.json"
    }
   },
   "await": true,
   "expect": "ok"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L07.c10.state.json"
  }
 ],
 "expect_recorded_events": "events/L07.recorded.events.json"
}