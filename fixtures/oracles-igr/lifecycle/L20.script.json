{
 "model": {
  "scene": "../oracles/o1-basic.scene.json",
  "layout": "../oracles-igl/layouts/F01.layout.json"
 },
 "env": {
  "host": "headless",
  "size": {
   "height": 600,
   "width": 900
  },
  "reducedMotion": false
 },
 "listener": "dispatch-inside",
 "calls": [
  {
   "op": "initialize",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "loadScene",
   "await": true,
   "expect": "ok"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "select",
    "mode": "replace",
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L20.c2.events.json",
   "expect_state": "states/L20.c2.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L20.c3.state.json"
  },
  {
   "op": "dispatch",
   "arg": {
    "type": "set-hidden",
    "hidden": true,
    "targets": [
     {
      "node": {
       "id": "i:1",
       "type": "person"
      }
     }
    ]
   },
   "await": true,
   "expect": "ok",
   "expect_events": "events/L20.c4.events.json",
   "expect_state": "states/L20.c4.state.json"
  },
  {
   "op": "getState",
   "await": true,
   "expect": "ok",
   "expect_state": "states/L20.c5.state.json"
  }
 ],
 "expect_listener_errors": [
  "INVALID_LIFECYCLE/REENTRANT",
  "INVALID_LIFECYCLE/REENTRANT",
  "INVALID_LIFECYCLE/REENTRANT"
 ]
}